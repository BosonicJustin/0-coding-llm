        "other_code": ["likely_minified"],
        "fineweb_edu": ["high_url_density"],
        "wikipedia": ["high_url_density"]
      },
      "soft_penalty_weights": {
        "possible_generated": 8,
        "very_long_line": 4
      },
      "missing_code_repo_id_action": "reject",
      "missing_english_source_identity_action": "reject"
